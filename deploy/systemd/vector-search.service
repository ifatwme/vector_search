[Unit]
Description=Vector search stack (Weaviate + llama.cpp + Streamlit + nginx)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/root/vector_search
# .env sets COMPOSE_FILE so the HTTPS override is included.
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
