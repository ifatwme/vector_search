# Copy to .env and adjust. Every value has a working default except TLS_DIR on the server.

# --- Server deployment (HTTPS on :8443 via deploy/compose.server.yml) ---
# COMPOSE_FILE=docker-compose.yml:deploy/compose.server.yml
# TLS_DIR=/root/ai-robotics-trends/deploy/tls
# HTTPS_PORT=8443

# --- Streamlit port (published on 127.0.0.1 only unless APP_BIND changes) ---
APP_BIND=127.0.0.1
APP_PORT=8501

# --- Assistant: "llm" (local llama.cpp model) or "grounded" (offline, no LLM) ---
CHAT_BACKEND=llm
# Any GGUF on Hugging Face as <repo>:<quant>; Qwen2.5-1.5B handles Persian well for its size.
LLM_HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct-GGUF:Q4_K_M
LLM_MODEL_NAME=qwen2.5-1.5b-instruct
LLM_THREADS=3

# --- Embeddings / ingestion ---
TORCH_THREADS=2
INGEST_THREADS=4
DOWNLOAD_WORKERS=8
INGEST_BATCH_SIZE=32
# Shards used by `make ingest` (0-4 + 143 = 2.6k products incl. the evaluation set). "all" = 70k.
INGEST_SHARDS=0-4,143
